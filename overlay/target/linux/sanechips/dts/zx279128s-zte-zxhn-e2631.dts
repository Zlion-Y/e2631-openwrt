// SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
/*
 * ZTE ZXHN E2631 (Sanechips ZX279128S, 2x ARM Cortex-A9) - stage 1 bring-up.
 *
 * Lives in the OpenWrt target, not in the kernel tree. It sits on top of the
 * SoC description that target patch 025 installs at
 * arch/arm/boot/dts/zte/zx279128s.dtsi, so every register window, interrupt
 * number and clock cell is inherited from there rather than copied here.
 *
 * Scope of this revision: reach a shell over UART, read the SPI-NAND, and let
 * the MDIO bus be probed. It turns on the peripherals that need no
 * board-specific wiring and stages PCIe and the panel behind the measurement
 * that fills them in. USB is deliberately left off - see the note on &usb
 * below; it is the one peripheral here that is known to be harmful.
 * Nothing in this file causes a write to flash.
 *
 * How to read a node's status:
 *   "okay"      its values are either inherited from the SoC file or measured
 *               on this board
 *   "disabled"  it is a shape waiting for a measurement; the comment on it
 *               names the TODO id and where the number has to come from
 *
 * Board provenance, strongest first:
 *
 *   1. the live /sys/firmware/fdt of this very board (an E2631 running the
 *      stock firmware), pulled over tftp and archived as refs/e2631_live.dtb
 *      with its decoded tree in refs/e2631_live_dt_tree.txt. This is the
 *      authoritative description of this hardware, and the analysis of it is
 *      in E2631原厂硬件视图-2026-10-12.txt. Where this file states a value it
 *      is because of this source.
 *   2. the DTB appended to the kernel1 partition of the same firmware - same
 *      tree, except that the kernel rewrites the memory node and bootargs at
 *      boot. Useful for seeing what the kernel changed.
 *   3. the vendor U-Boot description of firmware ZXHN E2631 V1.0.0.6B5.8000
 *      as transcribed by Zlion-Y/e2631-mainline-zx279128s, and the live fdt
 *      of a ZXHN F670L in cubingmucus998/zte-zx279128s-recon. Same silicon,
 *      so their values are evidence, but they are not this board.
 *
 * Anything that still starts with TODO is not in any of the three, and has to
 * be measured on this board: the panel, the port mapping and the PCIe reset
 * line are the whole of that list.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/input/input.h>

#include "zte/zx279128s.dtsi"

/ {
	model = "ZTE ZXHN E2631";
	compatible = "zte,zxhn-e2631", "zte,zx279128s";

	aliases {
		serial0 = &serial0;
		serial1 = &serial1;
		ethernet0 = &gmac;
		/*
		 * TODO-L1 once a power LED has been identified, point these at
		 * it so OpenWrt signals boot, failsafe and upgrade on the panel:
		 *   led-boot / led-failsafe / led-running / led-upgrade
		 * Until then nothing on the front panel tracks the boot state,
		 * which is acceptable for an image that only ever runs from RAM.
		 */
	};

	chosen {
		bootargs = "console=ttyAMA0,115200n8";
		stdout-path = "serial0:115200n8";
	};

	memory@40000000 {
		device_type = "memory";
		/*
		 * TODO-M1 closed: 256 MiB, measured on the running board.
		 *
		 * The stock firmware's own device tree is the source. Its
		 * /proc/device-tree/memory/reg reads 40 00 00 00 10 00 00 00,
		 * i.e. base 0x40000000 size 0x10000000, and its chosen/bootargs
		 * carries mem=256M, which is what the kernel rewrote that node
		 * from. /proc/iomem agrees (System RAM 0x40000000-0x4fffffff).
		 *
		 * Two traps, both from an earlier reading of this board:
		 *   - The same tree also has a memory@40000000 node still saying
		 *     0x20000000 (512 MiB). That one is a stale leftover nobody
		 *     rewrote; it is not evidence of 512 MiB and not evidence of
		 *     a contradiction.
		 *   - 128 MiB was used here before because it was the only size
		 *     known to boot. It boots because it is a subset, not because
		 *     it is right. The hardware has 256 MiB.
		 */
		reg = <0x40000000 0x10000000>;
	};

	/*
	 * No reserved-memory node.
	 *
	 * The H3600 keeps the top 38 MiB away from Linux for its packet
	 * processor, but that is that board's arrangement. Here the vendor
	 * device tree's memory reservations section is empty, and the stock
	 * kernel boots with all 256 MiB usable, so reserving anything would
	 * be inventing a hole.
	 */
};

/*
 * Console. 0x94404000 / 0x94405000 with GIC_SPI 11 and 12 are identical in the
 * vendor descriptions of all three boards seen so far, so these are settled.
 */
&serial0 {
	status = "okay";
};

&serial1 {
	status = "okay";
};

/*
 * SPI-NAND. The controller window 0x94406000 + 0x1000 and GIC_SPI 13 match the
 * vendor's own node, and the driver is the one patch 021/022 add.
 */
&spifc {
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		/*
		 * TODO-F1 taken from the H3600, which drives the same HYF1GQ4U
		 * family at 50 MHz with 2 data lines on read. U-Boot on this board
		 * identifies the chip as HYF1GQ4UTACAE, manuf 0x01 / chip 0x15.
		 * If reads come back with ECC errors or the controller stalls,
		 * drop this to <10000000>: 10 MHz was shown to checksum correctly.
		 */
		spi-max-frequency = <50000000>;
		spi-rx-bus-width = <2>;
		spi-tx-bus-width = <1>;

		/*
		 * No fixed-partitions child in this stage, on purpose: this
		 * stage exists to dump the chip, and one mtd spanning all
		 * 128 MiB is what tools/probe-e2631.sh consumes. No live node
		 * here means no label in this tree can be mistaken for a
		 * measurement.
		 *
		 * The layout IS now known. Source of truth: the vendor kernel
		 * carries its own partition table, in vmlinux at file offset
		 * 0x432358 - 15 entries, 0x20 bytes apart, {char *name;
		 * u32 pad; u64 size; u64 offset; u64 pad;}. It is not in
		 * /proc/cmdline and not in the device tree. It was then checked
		 * against the raw 128 MiB dump: cspboot's 32-byte slot marker
		 * (33 33 33 33 CC CC CC CC 88 88 88 88 DD DD DD DD) reads back
		 * at 0x700000 and 0x2300000 - exactly the two addresses the
		 * table itself calls kernel1 and kernel2 - and flash@0x6E00000
		 * equals mtdblock13 byte for byte.
		 *
		 *   name         offset       size        name         offset       size
		 *   bootloader   0x0000000    0x100000    defcfg       0x0500000    0x200000
		 *   tag          0x0100000    0x100000    kernel1      0x0700000    0x1C00000
		 *   wifi         0x0200000    0x100000    kernel2      0x2300000    0x1C00000
		 *   usercfg      0x0300000    0x200000    (rootfs)     -            -
		 *   UNIFIED      0x6E00000    0x100000    UUPlugin     0x6F00000    0x500000
		 *   DPIPlugin    0x7400000    0x300000    JDXBPLUGIN   0x7700000    0x180000
		 *   owdptsbin    0x7900000    0x0A0000    status       0x7A00000    0x500000
		 *
		 * kernel1 and kernel2 are the two 28 MiB A/B firmware slots, and
		 * each carries its own kernel and its own rootfs. The table's
		 * rootfs row is the placeholder (0,0) precisely because rootfs
		 * has no span of its own. Slot A: kernel at 0x700000 (3.25 MiB),
		 * rootfs at 0xA40000 (18.125 MiB), version header at 0x1C60000.
		 * Slot B mirrors it at 0x2300000 / 0x2640000 / 0x3860000. The
		 * 47 MiB from 0x3F00000 to 0x6E00000 is erased and free.
		 *
		 * Two things must be settled before this becomes live nodes in
		 * stage 2. Both are stage 2 questions, because neither affects
		 * an image that never writes:
		 *   - the vendor rootfs partitions are AES-128-ECB ciphertext on
		 *     flash (the vendor read path decrypts transparently), so
		 *     anything that interprets them has to decrypt offline;
		 *   - it is not yet proven that cspboot will boot a plaintext
		 *     slot, which is the same question as whether an
		 *     OpenWrt-written slot is bootable at all.
		 */
	};
};

/*
 * MDIO and the Ethernet ports.
 *
 * TODO-N1 what is settled, and what is not.
 *
 * Settled, from the stock firmware's own device tree:
 *   - the MDIO controller is at 0x9a101000 (0x18 bytes) and is enabled;
 *   - the SoC has four internal GEPHY blocks at 0x9b000000, 0x9b100000,
 *     0x9b200000 and 0x9b300000, interrupts 39..42. These are SoC-fixed,
 *     not board choices, and they match the H3600 exactly.
 *
 * Settled, from the stock firmware's running network stack:
 *   - this board has **four** gigabit ports, not five: br0 in the vendor
 *     firmware bridges eth1, eth2 and eth3 only, and eth0 is the sole
 *     PROMISC + UP uplink, i.e. WAN. So one WAN plus three LAN.
 *
 * NOT settled, and not guessable from the above:
 *   - which gmac_port maps to which panel socket, and which of the four
 *     is the WAN. The mapping the H3600 uses (port0..3 = LAN, port4 =
 *     WAN with an external ZX5201 on MDIO address 8) is that board's
 *     wiring. Copying it here would be a guess dressed as a measurement.
 *   - whether this board has any external PHY at all. Four internal
 *     GEPHY blocks cover four ports, so it may well have none.
 *
 * The nodes below are therefore kept as a working shape rather than as
 * a claim: whichever port has no PHY answering simply never gets a
 * netdev, dmesg says so per port, and everything else on the board still
 * boots. What fills this in is the probe, not further reasoning:
 *   tools/probe-e2631.sh mdio   lists every address that answers, and
 *   tools/probe-e2631.sh net    snapshots carrier per netdev, which
 *                               turns into the socket mapping once a
 *                               cable is moved from one port to the next.
 *
 * If boot ever stalls inside phylink, set &gmac back to "disabled": the
 * console and the flash dump do not depend on it.
 */
&mdio {
	status = "okay";

	/*
	 * TODO-N2 the H3600 muxes its external PHY through the pinctrl group
	 * ext_phy_pins (defined in the SoC file). Whether this board needs
	 * the same pins is unknown, so it is not referenced here. If the
	 * expected PHYs stay silent at every address, add:
	 *   pinctrl-names = "default";
	 *   pinctrl-0 = <&ext_phy_pins>;
	 */
	phy8: ethernet-phy@8 {
		reg = <8>;
	};

	phy10: ethernet-phy@10 {
		reg = <10>;
	};

	phy11: ethernet-phy@11 {
		reg = <11>;
	};

	phy12: ethernet-phy@12 {
		reg = <12>;
	};

	phy13: ethernet-phy@13 {
		reg = <13>;
	};
};

&gmac {
	status = "okay";
};

/*
 * TODO-N1 the four port nodes below carry no "label" on purpose.
 *
 * The board has four sockets, but nothing measured so far says which gmac
 * port drives which socket, or which one is the WAN. A label is a claim
 * about the panel, so writing "lan1"/"wan" here would bake a guess into
 * every interface name downstream (board.d, firewall zones, the lot).
 * Without a label the ports still come up as plain netdevs, which is all
 * stage 1 needs, and the mapping gets filled in from the probe's carrier
 * snapshot once a cable is walked from socket to socket.
 *
 * The phy-handle values are the H3600's and are equally unverified. They
 * are kept because the four internal GEPHY blocks are SoC-fixed, so some
 * address in this range almost certainly answers; the probe's "mdio" mode
 * prints which ones actually do.
 */
&gmac_port0 {
	phy-handle = <&phy10>;
	phy-mode = "internal";
	status = "okay";
};

&gmac_port1 {
	phy-handle = <&phy11>;
	phy-mode = "internal";
	status = "okay";
};

&gmac_port2 {
	phy-handle = <&phy12>;
	phy-mode = "internal";
	status = "okay";
};

&gmac_port3 {
	phy-handle = <&phy13>;
	phy-mode = "internal";
	status = "okay";
};

/*
 * TODO-N1 port4 is probably not wired on this board.
 *
 * The H3600 uses a fifth port for WAN behind an external ZX5201 PHY on
 * MDIO address 8. This board only has four sockets, and four internal
 * GEPHY blocks already cover them, so a fifth port would need an external
 * PHY that may not be there. Kept enabled so the boot log answers the
 * question instead of the comment: if nothing answers at address 8, this
 * port simply never appears, and that is the measurement.
 */
&gmac_port4 {
	phy-handle = <&phy8>;
	phy-mode = "gmii";
	status = "okay";
};

/* ---------------------------------------------------------------------------
 * Peripherals
 *
 * Everything below is a status plus board wiring, if any: every register
 * window and interrupt comes from the SoC file this one includes.
 * ------------------------------------------------------------------------- */

/*
 * USB. Deliberately NOT enabled, and not by oversight.
 *
 * The SoC has two controllers - DWC3 at 0x09100000 (GIC_SPI 50) and DWC2 at
 * 0x09000000 (GIC_SPI 44) - and the stock firmware device tree marks both
 * "okay". On this board, reaching either of them is harmful: the reports are
 * of the USB controller being touched, the system then hanging, and the
 * hardware watchdog restarting it in a loop. A board that reboots in a loop
 * is not a board that can be probed, so USB stays off rather than being a
 * cheap thing to try.
 *
 * Three separate switches all have to stay off, and this file is only the
 * first of them:
 *   1. here - &usb keeps its inherited status = "disabled", so no controller
 *      is registered and nothing pokes 0x09100000;
 *   2. seed/e2631.config turns CONFIG_USB_SUPPORT off, so no USB code is
 *      built into the kernel at all;
 *   3. this device's fragment carries no USB kmod, so no module can bring a
 *      controller back up at runtime. (The H3600 relies on DEVICE_PACKAGES
 *      for that; nothing does here.)
 *
 * Note the interaction with the target's own config, which is why (2) has to
 * be explicit: config-6.18 sets CONFIG_USB=m and CONFIG_USB_DWC3=m, and
 * kmod-usb-dwc3 is a package a later change could pull in without anyone
 * intending to enable USB. Turning the symbols off in the seed removes that
 * possibility instead of relying on nobody adding the package.
 *
 * TODO-U1 is withdrawn, not deferred. Whether the panel area exposes a USB
 * socket is no longer a question worth answering: even if it does, this board
 * must not bring the controller up. If that ever changes it needs a kernel
 * that has been shown not to hang first, not a device tree edit.
 */
&usb {
	status = "disabled";
};

/*
 * PCIe. Both controllers are fully described in the SoC file - dbi, ctrl and
 * config windows, outbound ranges, dma-ranges and the pinctrl groups - so the
 * only thing missing is board wiring: the reset and enable lines.
 *
 * TODO-W1 the pair below is a guess, and the vendor tree argues against it.
 *
 * What the guess is: <&gpio3 5> and <&gpio3 7>, copied from the H3600, where
 * a single MT7915 hangs off both links and either controller may release it.
 *
 * Why it is weaker than it looks. The stock firmware's own device tree has a
 * pcie@10000000 node that is status "okay" and carries no board wiring at
 * all: no reg, no reset-gpios, no enable-gpios, no pinctrl-0. Whatever resets
 * this link, the vendor does not express it in the device tree - it is either
 * done by the boot loader before Linux starts, or hard-wired in the vendor
 * driver. So there is no positive evidence for gpio3 5 / gpio3 7 here, only
 * the shared-SoC resemblance.
 *
 * What the vendor tree does settle: its node lists four interrupts (SPI 63,
 * 78, 59, 74), and 63 and 78 are exactly the two controllers' main
 * interrupts in the SoC file. So this board has two PCIe controllers, like
 * the H3600, and is expected to carry one MT7916 (CONFIG_WLAN_MTK_7916 is in
 * the vendor config); whether that chip answers on one link or two is
 * unmeasured.
 *
 * Unlike a wrong LED GPIO, a wrong reset line is not cosmetic: the controller
 * can hang. If the boot log stops inside the PCIe driver, set both nodes back
 * to "disabled" and boot again - this image never writes flash, so the retry
 * costs nothing. The link is worth having: without it there is no Wi-Fi, and
 * probe mode "pcie" is what tells us whether anything enumerated.
 */
&pcie0 {
	reset-gpios = <&gpio3 5 GPIO_ACTIVE_LOW>;
	enable-gpios = <&gpio3 7 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&pcie1 {
	reset-gpios = <&gpio3 5 GPIO_ACTIVE_LOW>;
	enable-gpios = <&gpio3 7 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

/*
 * The panel: LEDs and buttons.
 *
 * TODO-L1 deliberately left as a shape rather than a node. LED routing is per
 * board, so not one of the H3600's numbers may be copied, and a wrong number
 * here would be a silently wrong claim. Identify the real lines by toggling
 * each GPIO and watching the front panel (tools/probe-e2631.sh, "gpio" mode),
 * then uncomment this into the root node and fill the numbers in:
 *
 * A note on why the stock device tree cannot help either: it has no led or
 * key node at all (checked against the live /sys/firmware/fdt, 27 nodes under
 * /soc and not one gpio consumer among them). That is not an omission - the
 * vendor kernel carries CONFIG_CSPKERNEL_LEDKEY, its own LED/key framework,
 * and drives the panel from that instead of through gpio-leds/gpio-keys. So
 * there is no upstream-readable description of this board's panel anywhere.
 * Only a measurement on the physical board produces the numbers.
 *
 *	leds {
 *		compatible = "gpio-leds";
 *
 *		led_power: led-power {
 *			function = LED_FUNCTION_POWER;
 *			gpios = <&gpioN M GPIO_ACTIVE_LOW>;
 *			default-state = "on";
 *		};
 *	};
 *
 *	keys {
 *		compatible = "gpio-keys-polled";
 *		poll-interval = <50>;	// &gpio has no interrupt support
 *
 *		key-reset {
 *			label = "reset";
 *			gpios = <&gpioN M GPIO_ACTIVE_LOW>;
 *			linux,code = <KEY_RESTART>;
 *			debounce-interval = <60>;
 *		};
 *	};
 *
 * The aliases block at the top of this file is where led-boot, led-running
 * and the rest get pointed at those nodes once they exist.
 */

/*
 * TODO-A1 the MAC address. The H3600 reads six bytes at offset 0x1e of the
 * "tag" partition (flash 0x100000) and the WAN port uses the next one. That
 * partition exists here and is plaintext, but the offset is unverified. Until
 * it is measured - the same probe prints the tag header - the interfaces come
 * up with a random locally administered address, which is acceptable for a
 * RAM image and must not ship.
 *
 *	&gmac_port0 {
 *		nvmem-cells = <&macaddr_tag_1e 0>;
 *		nvmem-cell-names = "mac-address";
 *	};
 *
 * That needs the tag partition's fixed-partitions child and an nvmem-layout,
 * which is a stage 2 change: it is the point where the flash layout becomes
 * live in this tree.
 */
