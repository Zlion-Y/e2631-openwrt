# Seed .config for the E2631 stage-1 RAM image.
# Copy over <tree>/.config, then run `make defconfig`.

# --- target, and only this device ---------------------------------------
CONFIG_TARGET_sanechips=y
CONFIG_TARGET_sanechips_generic=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_ALL_PROFILES=n
CONFIG_TARGET_DEVICE_sanechips_generic_DEVICE_zte_zxhn-e2631=y
# The H3600 costs build time and is not what we are testing here.
# CONFIG_TARGET_DEVICE_sanechips_generic_DEVICE_zte_zxhn-h3600 is not set

# --- the one symbol that decides whether an initramfs image is produced --
# include/image.mk gates Device/Build/initramfs on this. Without it the build
# succeeds and simply emits no ...-initramfs.uImage, which is a confusing way
# to fail, so it is set explicitly rather than left to defconfig.
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# --- keep the build small -----------------------------------------------
# CONFIG_ALL_KMODS is not set
# CONFIG_ALL_NONSHARED is not set
# CONFIG_SIGNED_PACKAGES is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set
# CONFIG_TARGET_ROOTFS_CPIOGZ is not set
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# A squashfs image is built but never flashed; it only exists because the
# rootfs is what gets embedded into the initramfs kernel.
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_ip-tiny=y
CONFIG_PACKAGE_ubusd=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
# The probe script serves its evidence bundle over uhttpd.
